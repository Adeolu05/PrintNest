# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Public app ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PrintNest
# Local demo: bypass Supabase auth in dev and go straight to dashboard
NEXT_PUBLIC_DEMO_AUTH_BYPASS=false

# --- Supabase ---
# Project URL: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
# anon public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key (server only — bypasses RLS, never expose in browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# --- Storage (optional Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Observability (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
